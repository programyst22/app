{
  "expo": {
    "name": "OKA Control",
    "slug": "oka-bau",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "okabau",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.okabuildplatform.hpgnts",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Fotos Ihrer Baustelle an OKA Bau senden",
        "NSCameraUsageDescription": "Baustellenfotos direkt aufnehmen und teilen"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.okabuildplatform.hpgnts",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0C"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E66A32"
        }
      ],
      "expo-image-picker",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
